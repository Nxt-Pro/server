# NxtPro Backend Environment Example
# Copy to server/.env for local development or to the server environment for
# deployment. Do not commit real secrets.

# Core runtime
NODE_ENV=development
PORT=3000
# Use a concrete frontend origin in production; do not use * there.
CORS_ORIGIN=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:8081
STRICT_EXTERNAL_CONFIG_VALIDATION=false

# JWT/auth
# Production values must be unique secrets with at least 32 characters.
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
JWT_REFRESH_EXPIRES_IN=30d

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace_with_database_password
DB_NAME=nxtpro
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
# Keep false by default. Run migrations intentionally with npm run migration:run.
DB_MIGRATIONS_RUN=false
DB_POOL_SIZE=20
DB_QUERY_TIMEOUT=5000

# Redis, BullMQ queues, and cache
# Local Docker Redis is the default provider. If running the API directly on
# the host instead of Docker Compose, use REDIS_HOST=localhost.
REDIS_PROVIDER=local
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=local_redis_password
REDIS_TLS=false
REDIS_DB_QUEUE=0
REDIS_DB_CACHE=1

# Optional Upstash TCP mode. Do not commit real tokens.
# REDIS_PROVIDER=upstash
# REDIS_URL=rediss://default:<token>@<host>:6379
# REDIS_TLS=true

CACHE_TTL=300
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_LIMITER_MAX=10
QUEUE_LIMITER_DURATION=1000

# AI scoring
# Production scoring runs through backend queues and internal AI services.
# In production-like runtime, these three service URLs are required when
# AI_SCORING_ENABLED=true and USE_MOCK_AI=false.
AI_SCORING_ENABLED=false
AI_SCORING_QUEUE_ENABLED=true
AI_SKILL_SERVICE_URL=http://localhost:8001
AI_RECOMMENDATION_SERVICE_URL=http://localhost:8002
AI_MODERATION_SERVICE_URL=http://localhost:8003
AI_SERVICE_TIMEOUT_MS=120000
AI_SERVICE_RETRY_ATTEMPTS=3
AI_SCORING_MAX_MEDIA_BYTES=104857600
# Legacy compatibility only. Do not expose this key in the mobile app.
USE_MOCK_AI=false
AI_MODEL_API_URL=http://localhost:8001
AI_MODEL_API_KEY=
AI_MODEL_TIMEOUT_MS=120000

# Uploads and media URLs
# Production storage is currently local API-server disk only. Do not set
# UPLOAD_STORAGE_PROVIDER=cloud until a storage adapter is implemented.
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_LOCAL_DIR=uploads
# Production must be a public API URL, not localhost.
UPLOAD_PUBLIC_BASE_URL=http://localhost:3000/uploads
# Reserved for a real provider/fronting setup. Local storage responses use
# UPLOAD_PUBLIC_BASE_URL; do not put a fake provider URL here.
CDN_BASE_URL=
MAX_VIDEO_SIZE_MB=500
MAX_AUDIO_SIZE_MB=50
ALLOWED_VIDEO_FORMATS=mp4,mov,m4v,avi,webm,mkv,3gp
ALLOWED_AUDIO_FORMATS=mp3,m4a,aac,wav,ogg,oga,flac,webm

# Firebase Admin / push delivery
# Required only for real FCM delivery. If omitted, the backend starts and logs
# that notifications will not be sent.
FIREBASE_PROJECT_ID=replace_with_firebase_project_id
FIREBASE_CLIENT_EMAIL=replace_with_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key\n-----END PRIVATE KEY-----\n"

# Nodemailer / SMTP
# Required in production because strict external validation is enabled there.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@example.com
MAIL_PASSWORD=replace_with_smtp_password
MAIL_SECURE=false
MAIL_FROM=NxtPro <no-reply@example.com>

# OAuth
# Required in production because strict external validation is enabled there.
GOOGLE_OAUTH_CLIENT_IDS=replace_with_google_client_ids_comma_separated
GOOGLE_OAUTH_WEB_CLIENT_ID=replace_with_google_web_client_id
GOOGLE_OAUTH_ANDROID_CLIENT_ID=replace_with_google_android_client_id
GOOGLE_OAUTH_IOS_CLIENT_ID=replace_with_google_ios_client_id
GOOGLE_OAUTH_EXPO_CLIENT_ID=replace_with_google_expo_client_id
FACEBOOK_APP_ID=replace_with_facebook_app_id
FACEBOOK_APP_SECRET=replace_with_facebook_app_secret

# Super admin seed credentials
# Required when running npm run seed:run with NODE_ENV=production.
SUPER_ADMIN_1_USERNAME=superadmin1
SUPER_ADMIN_1_EMAIL=superadmin1@example.com
SUPER_ADMIN_1_PASSWORD=replace_with_strong_admin_password_1
SUPER_ADMIN_2_USERNAME=superadmin2
SUPER_ADMIN_2_EMAIL=superadmin2@example.com
SUPER_ADMIN_2_PASSWORD=replace_with_strong_admin_password_2
