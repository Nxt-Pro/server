# Environment Variables for NxtPro Backend
PORT = 3000
CORS_ORIGIN = *
NODE_ENV = development
FRONTEND_BASE_URL = http://localhost:8081

# Temporary dev toggle: keep false while mail/OAuth credentials are not ready.
# Set to true (or use NODE_ENV=production) to enforce strict validation.
STRICT_EXTERNAL_CONFIG_VALIDATION = false

# JWT Configuration
JWT_SECRET = your_jwt_secret
JWT_EXPIRES_IN = 7d
JWT_REFRESH_SECRET = your_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN = 30d

# Database Configuration
DB_HOST = localhost
DB_PORT = 5432
DB_USERNAME = postgres
DB_PASSWORD = your_DB_password
DB_NAME = your_DB_name
DB_SYNCHRONIZE = false

# Redis Configuration
REDIS_HOST = your_redis_host
REDIS_PORT = 6379
REDIS_PASSWORD = your_redis_password
REDIS_TLS = true
REDIS_DB_QUEUE = 0
REDIS_DB_CACHE = 1

# BullMQ Configuration
QUEUE_CONCURRENCY = 5
QUEUE_MAX_RETRIES = 3
QUEUE_LIMITER_MAX = 10
QUEUE_LIMITER_DURATION = 1000

# AI Model Configuration (NxtPro AI Integration Guide v1.3)
# true = random scores, no external calls (good for local dev without GPU/API key).
# false = RealAiModelService calls https://api.nxtpro.ai (multipart) from the worker.
USE_MOCK_AI = true
AI_MODEL_API_URL = https://api.nxtpro.ai
AI_MODEL_API_KEY = your_nxtpro_ai_model_api_key
# Optional: timeout in ms for download + AI HTTP (default 120000)
# AI_MODEL_TIMEOUT_MS = 120000

# CDN & Upload Configuration
CDN_BASE_URL = https://cdn.nxtpro.com
MAX_VIDEO_SIZE_MB = 500
ALLOWED_VIDEO_FORMATS = mp4,mov,avi,webm

# Firebase Configuration
FIREBASE_PROJECT_ID = your_firebase_project_id
FIREBASE_CLIENT_EMAIL = your_firebase_client_email
FIREBASE_PRIVATE_KEY = your_firebase_private_key

# Nodemailer / SMTP Configuration
MAIL_HOST = smtp.gmail.com
MAIL_PORT = 587
MAIL_USER = your_company_email@example.com
MAIL_PASSWORD = your_smtp_app_password
MAIL_SECURE = false
MAIL_FROM = NxtPro <no-reply@nxtpro.app>

# OAuth Configuration (Backend Verification)
GOOGLE_OAUTH_CLIENT_IDS = your_google_oauth_client_ids_comma_separated
GOOGLE_OAUTH_WEB_CLIENT_ID = your_google_oauth_web_client_id
GOOGLE_OAUTH_ANDROID_CLIENT_ID = your_google_oauth_android_client_id
GOOGLE_OAUTH_IOS_CLIENT_ID = your_google_oauth_ios_client_id
GOOGLE_OAUTH_EXPO_CLIENT_ID = your_google_oauth_expo_client_id

FACEBOOK_APP_ID = your_facebook_app_id
FACEBOOK_APP_SECRET = your_facebook_app_secret
