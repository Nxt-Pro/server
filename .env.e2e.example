# NxtPro server e2e environment.
# Used by npm run test:e2e and docker-compose.e2e.yml. These are local-only
# credentials for an isolated test database.

NODE_ENV=test
PORT=3001
STRICT_EXTERNAL_CONFIG_VALIDATION=false
CORS_ORIGIN=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:8081

JWT_SECRET=e2e_local_jwt_secret_minimum_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=e2e_local_refresh_secret_minimum_32_chars
JWT_REFRESH_EXPIRES_IN=30d

DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=nxtpro_e2e
DB_PASSWORD=nxtpro_e2e_password
DB_NAME=nxtpro_e2e
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_MIGRATIONS_RUN=true
DB_POOL_SIZE=5
DB_QUERY_TIMEOUT=5000

REDIS_PROVIDER=local
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=nxtpro_e2e_redis_password
REDIS_TLS=false
REDIS_DB_QUEUE=0
REDIS_DB_CACHE=1

CACHE_TTL=60
QUEUE_CONCURRENCY=1
QUEUE_MAX_RETRIES=1
QUEUE_LIMITER_MAX=10
QUEUE_LIMITER_DURATION=1000

AI_SCORING_ENABLED=false
AI_SCORING_QUEUE_ENABLED=false
AI_SKILL_SERVICE_URL=http://localhost:8001
AI_RECOMMENDATION_SERVICE_URL=http://localhost:8002
AI_MODERATION_SERVICE_URL=http://localhost:8003
AI_SERVICE_TIMEOUT_MS=5000
AI_SERVICE_RETRY_ATTEMPTS=1
AI_SCORING_MAX_MEDIA_BYTES=104857600
USE_MOCK_AI=false
AI_MODEL_API_URL=http://localhost:8001
AI_MODEL_API_KEY=
AI_MODEL_TIMEOUT_MS=5000

UPLOAD_STORAGE_PROVIDER=local
UPLOAD_LOCAL_DIR=.tmp/e2e-uploads
UPLOAD_PUBLIC_BASE_URL=http://localhost:3001/uploads
CDN_BASE_URL=
MAX_VIDEO_SIZE_MB=500
MAX_AUDIO_SIZE_MB=50
ALLOWED_VIDEO_FORMATS=mp4,mov,m4v,avi,webm,mkv,3gp
ALLOWED_AUDIO_FORMATS=mp3,m4a,aac,wav,ogg,oga,flac,webm

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_SECURE=false
MAIL_FROM=
GOOGLE_OAUTH_CLIENT_IDS=
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=
GOOGLE_OAUTH_EXPO_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
