# NxtPro Server Docker Compose Environment Example
# Copy to .env.docker and run from the server repo root:
# docker compose --env-file .env.docker up -d --build
#
# These values are for local/staging Compose only. Do not commit real secrets.

NODE_ENV=development
STRICT_EXTERNAL_CONFIG_VALIDATION=false

API_PUBLISHED_PORT=3000
DB_PUBLISHED_PORT=5433
REDIS_PUBLISHED_PORT=6380

CORS_ORIGIN=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:8081

JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
JWT_REFRESH_EXPIRES_IN=30d

DB_NAME=nxtpro
DB_USERNAME=nxtpro
DB_PASSWORD=replace_with_compose_database_password
DB_MIGRATIONS_RUN=false
DB_POOL_SIZE=20
DB_QUERY_TIMEOUT=5000

# Local Docker Redis is the default provider.
REDIS_PROVIDER=local
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=local_redis_password
REDIS_TLS=false
REDIS_DB_QUEUE=0
REDIS_DB_CACHE=1

# Optional Upstash TCP mode.
# REDIS_PROVIDER=upstash
# REDIS_URL=rediss://default:<token>@<host>:6379
# REDIS_TLS=true

CACHE_TTL=300
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_LIMITER_MAX=10
QUEUE_LIMITER_DURATION=1000

USE_MOCK_AI=true
AI_MODEL_API_URL=https://api.nxtpro.ai
AI_MODEL_API_KEY=
AI_MODEL_TIMEOUT_MS=120000

UPLOAD_PUBLIC_BASE_URL=http://localhost:3000/uploads
# Optional CDN fronting base for /uploads. Leave empty until a real CDN fronts
# this path; do not put a fake provider URL here.
CDN_BASE_URL=
MAX_VIDEO_SIZE_MB=500
ALLOWED_VIDEO_FORMATS=mp4,mov,m4v,avi,webm,mkv,3gp

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_SECURE=false
MAIL_FROM=

GOOGLE_OAUTH_CLIENT_IDS=
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=
GOOGLE_OAUTH_EXPO_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

SUPER_ADMIN_1_USERNAME=superadmin1
SUPER_ADMIN_1_EMAIL=superadmin1@nxtpro.local
SUPER_ADMIN_1_PASSWORD=replace_with_compose_admin_password_1
SUPER_ADMIN_2_USERNAME=superadmin2
SUPER_ADMIN_2_EMAIL=superadmin2@nxtpro.local
SUPER_ADMIN_2_PASSWORD=replace_with_compose_admin_password_2
